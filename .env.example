# =====================================================================
#  Copia este archivo como ".env" y cambia los valores si quieres:
#      cp .env.example .env
#  (El .env real NO se sube a GitHub: esta en el .gitignore)
#  Si no creas el .env, docker-compose usa estos mismos valores por defecto.
# =====================================================================

# --- PostgreSQL (lo usan Python, Java y Go) ---
DB_USER=admin
DB_PASS=supersecreta
DB_NAME=proyecto

# --- MongoDB (lo usa Node) ---
MONGO_URL=mongodb://mongodb:27017/productos_db

# --- URLs internas para que los microservicios se hablen entre si ---
# Dentro de Docker cada servicio se llama por su nombre en docker-compose.yml
USUARIOS_SERVICE_URL=http://servicio-python:8000
PRODUCTOS_SERVICE_URL=http://servicio-node:3000
ORDENES_SERVICE_URL=http://servicio-java:8080
