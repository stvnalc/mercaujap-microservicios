# =====================================================================
#  Copia este archivo como ".env" y cambia los valores si quieres:
#      cp .env.example .env
#  (El .env real NO se sube a GitHub: esta en el .gitignore)
#  Si no creas el .env, docker-compose usa estos mismos valores por defecto.
# =====================================================================

# --- Puerto del API Gateway (el UNICO puerto que se abre en tu PC) ---
# El sistema queda en http://localhost:8080. Cambialo si ese puerto ya esta ocupado.
PUERTO=8080

# --- PostgreSQL (lo usan Python, Java y Go) ---
DB_USER=admin
DB_PASS=supersecreta
DB_NAME=proyecto

# --- MongoDB (lo usa Node) ---
MONGO_URL=mongodb://mongodb:27017/productos_db

# --- URLs internas para que los microservicios se hablen entre si ---
# Dentro de Docker cada servicio se llama por su nombre en docker-compose.yml
USUARIOS_SERVICE_URL=http://servicio-python:8000
PRODUCTOS_SERVICE_URL=http://servicio-node:3000
ORDENES_SERVICE_URL=http://servicio-java:8080
# Canal de tiempo real: Python y Java avisan aqui sus cambios (servicio-node los reenvia por WebSocket)
EVENTOS_URL=http://servicio-node:3000/interno/eventos

# --- Seguridad: clave con la que se firman los tokens de sesion (JWT) ---
# En produccion usa una clave larga y aleatoria
JWT_SECRET=mercaujap-clave-de-desarrollo-cambiar-en-produccion

# --- Datos de demostracion: pedidos de ejemplo de los ultimos 60 dias ---
DEMO_DATA=true
